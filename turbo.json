{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "FLAG_*",
        "NEXT_PUBLIC_*",
        "NEXT_PUBLIC_PARTNER_URL",
        "SUPABASE_*",
        "NEXT_TELEMETRY_DISABLED",
        "VERCEL",
        "VERCEL_ENV",
        "AUTH_METHODS",
        "RATE_LIMIT_HMAC_SECRET",
        "CRON_SECRET",
        "NEXT_DIST_DIR"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": [
        "FLAG_*",
        "NEXT_PUBLIC_*",
        "NEXT_PUBLIC_PARTNER_URL",
        "SUPABASE_*",
        "VERCEL",
        "VERCEL_ENV",
        "AUTH_METHODS",
        "RATE_LIMIT_HMAC_SECRET",
        "CRON_SECRET",
        "NEXT_DIST_DIR"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "FLAG_*",
        "NEXT_PUBLIC_*",
        "NEXT_PUBLIC_PARTNER_URL",
        "SUPABASE_*",
        "VERCEL",
        "VERCEL_ENV",
        "AUTH_METHODS",
        "RATE_LIMIT_HMAC_SECRET",
        "CRON_SECRET",
        "NEXT_DIST_DIR"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".next/types/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["FLAG_*"]
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "FLAG_*",
        "NEXT_PUBLIC_*",
        "NEXT_PUBLIC_PARTNER_URL",
        "SUPABASE_*",
        "E2E_PORT",
        "VERCEL",
        "VERCEL_ENV",
        "AUTH_METHODS",
        "RATE_LIMIT_HMAC_SECRET",
        "CRON_SECRET",
        "NEXT_DIST_DIR"
      ],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "HOME"]
    },
    "test:e2e:auth": {
      "cache": false,
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_*",
        "VERCEL",
        "VERCEL_ENV",
        "AUTH_METHODS",
        "RATE_LIMIT_HMAC_SECRET",
        "CRON_SECRET",
        "NEXT_DIST_DIR",
        "MAILPIT_URL"
      ],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "HOME"]
    }
  }
}

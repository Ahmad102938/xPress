# @acurexpress/partner (partners.acurexpress.com) environment variables.
# Copy to apps/partner/.env.local (git-ignored) and fill in. Local values come from `pnpm supabase status`.
# Never commit real values. The placeholder pages read none of these yet.

# --- Supabase (same project as web; needed once partner sign-in lands) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key, safe for the browser

# --- Feature flags (server-side, same names as web). Defaults live in @acurexpress/core. ---
# FLAG_MEDICINE_SALES=false
# FLAG_SHOP_NETWORK=true

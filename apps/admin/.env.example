# @acurexpress/admin (admin.acurexpress.com) environment variables.
# Copy to apps/admin/.env.local (git-ignored) and fill in. Local values come from `pnpm supabase status`.
# Never commit real values. The placeholder page reads none of these yet.

# --- Supabase (same project as web; needed once staff sign-in with MFA lands) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key, safe for the browser
# SUPABASE_SERVICE_ROLE_KEY=            # server only, only if an admin server action truly needs it. NEVER NEXT_PUBLIC_

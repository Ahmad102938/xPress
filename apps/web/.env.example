# @acurexpress/web (acurexpress.com) environment variables.
# Copy to apps/web/.env.local (git-ignored) and fill in. Local values come from `pnpm supabase status`.
# Never commit real values. Test or sandbox keys only outside production.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key, safe for the browser
SUPABASE_SERVICE_ROLE_KEY=              # server only. NEVER expose to the browser, never prefix with NEXT_PUBLIC_

# --- Sign-in (docs/AUTH.md, docs/specs/auth.md) ---
# Use the LOCAL stack for development: values from `pnpm supabase status` (never a remote project).
# Methods shown, comma list of phone,email,google. Unset means google only.
#   local: phone,email,google      deployed: email,google until DLT (SMS) is approved
# Production hides every method while legal versions are placeholders (draft-*).
# AUTH_METHODS=phone,email,google
# This site's own origin; OAuth redirects are built from it, never from the Host header.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (Supabase captcha). Unset = no widget. Secret lives in Supabase.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only. HMAC key for rate-limit keys (required on Vercel; a local fallback is used locally).
# RATE_LIMIT_HMAC_SECRET=
# Server only. Bearer secret for the daily /api/cron/auth-cleanup job (Vercel cron).
# CRON_SECRET=

# --- Signed-in experience (docs/specs/signed-in-home.md, docs/AUTH.md) ---
# Client idle sign-out after this many minutes without activity (1-1440, default 30, TODO_HCQ).
# The recent sign-in window (15 min) is the app_settings row recent_auth_minutes, not an env var.
# SESSION_IDLE_MINUTES=30
# DEVELOPMENT ONLY: "1" shows the full signed-in home with fake fixture data. Never set it on
# Vercel: a production build ignores it, and a Vercel production build fails if it is set.
# PATIENT_HOME_FIXTURES=

# --- Feature flags (server-side). Set to "true" or "false". ---
# Regulated services stay off until HCQ Care clears the launch gate.
# FLAG_MEDICINE_SALES=false
# FLAG_ONLINE_PRESCRIBING=false
# FLAG_AI_CONSULTANT=false
# FLAG_NATIVE_APP_FEATURES=false
# Shop network (map + shop discovery). Phase 1, not regulated, so it defaults to true.
# FLAG_SHOP_NETWORK=true

# --- Partner band in the footer (the only partner link on the patient site) ---
# Base URL of the partner app. In development it defaults to http://partners.localhost:3001.
# If it is missing in a production build, the partner band is hidden. Switch: showPartnerBlock in
# apps/web/src/config/partner-band.ts. The patient site never links to the admin app.
# NEXT_PUBLIC_PARTNER_URL=https://partners.acurexpress.com

# --- Payments (Razorpay or Cashfree; not wired yet) ---
# PAYMENTS_PROVIDER=
# PAYMENTS_KEY_ID=
# PAYMENTS_KEY_SECRET=                  # server only
# PAYMENTS_WEBHOOK_SECRET=              # server only

# --- SMS / WhatsApp (MSG91 or Gupshup, DLT registered; not wired yet) ---
# SMS_PROVIDER=
# SMS_API_KEY=                          # server only
# SMS_SENDER_ID=

# --- Maps (Google Maps, Mappls or Ola Maps; not wired yet) ---
# NEXT_PUBLIC_MAPS_PUBLIC_KEY=          # browser key, restrict by referrer
# MAPS_SERVER_KEY=                      # server only (geocoding)

# --- Video consultation (100ms, Daily or Agora; not wired yet) ---
# VIDEO_PROVIDER=
# VIDEO_API_KEY=                        # server only
# VIDEO_API_SECRET=                     # server only

# --- AI Health Consultant (server-side LLM behind safety layer; not wired yet) ---
# AI_PROVIDER=
# AI_API_KEY=                           # server only

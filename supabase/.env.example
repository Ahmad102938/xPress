# Local Supabase CLI secrets. Copy to supabase/.env (git-ignored) and fill only what you test.
# Names only; never commit values. See docs/AUTH.md.

# Google sign-in (also set [auth.external.google] enabled = true in config.toml, then restart)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Cloudflare Turnstile secret (also set [auth.captcha] enabled = true, then restart)
SUPABASE_AUTH_CAPTCHA_SECRET=

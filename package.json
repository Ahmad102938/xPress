{
  "name": "acurexpress",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "//db": "All db:* scripts target the LOCAL stack only. This checkout is linked to a remote project; never add --remote here.",
    "db:keys": "node scripts/db-keys.mjs",
    "db:start": "pnpm db:keys && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types --local --lang typescript > packages/db/src/database.types.ts",
    "db:test": "supabase test db",
    "prepare": "husky"
  },
  "devDependencies": {
    "@acurexpress/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.2.0",
    "turbo": "2.11.10"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  }
}
